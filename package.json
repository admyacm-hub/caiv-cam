{
  "name": "caivcam-website",
  "version": "1.0.0",
  "description": "Site oficial do CAIVCAM - Centro de Apoio à Vítima de Violência da Camama",
  "main": "public/index.html",
  "scripts": {
    "dev": "live-server public/",
    "start": "npx serve public/",
    "build": "echo 'No build required for static site'",
    "test": "echo 'No tests configured'",
    "deploy": "netlify deploy --prod",
    "optimize": "node scripts/optimize-images.js",
    "format": "prettier --write 'public/**/*.{html,css,js}'",
    "lint": "eslint public/js/**/*.js"
  },
  "keywords": [
    "CAIVCAM",
    "violência doméstica",
    "Angola",
    "Luanda",
    "apoio social"
  ],
  "author": "CAIVCAM",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.4.0",
    "font-awesome": "^4.7.0"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "prettier": "^3.2.4",
    "eslint": "^8.56.0"
  }
}
